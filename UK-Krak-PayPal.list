# NAME: UK-Krak-PayPal
# AUTHOR: pangtianlu
# DESC: Combined Krak + Kraken + PayPal rules for Loon UK routing.
# NOTE: Do not put a policy name in this file. In Loon subscribe with policy=UK node/group name.
# UPDATED: 2026-09-04

# Krak / Kraken
DOMAIN-SUFFIX,krak.app
DOMAIN-SUFFIX,krakbank.app
DOMAIN-SUFFIX,kraken.com
DOMAIN-SUFFIX,krakenfx.com
DOMAIN-SUFFIX,payward.com
DOMAIN-SUFFIX,k.k.xyz
DOMAIN-SUFFIX,p.k.xyz
DOMAIN-SUFFIX,cryptowat.ch
DOMAIN-SUFFIX,futures.kraken.com
DOMAIN-SUFFIX,demo-futures.kraken.com
DOMAIN-KEYWORD,kraken
USER-AGENT,Kraken*
USER-AGENT,Krak*

# PayPal
DOMAIN-SUFFIX,paypal.com
DOMAIN-SUFFIX,paypalobjects.com
DOMAIN-SUFFIX,paypal-objects.com
DOMAIN-SUFFIX,paypal.me
DOMAIN-SUFFIX,paypal-community.com
DOMAIN-SUFFIX,paypal-mktg.com
DOMAIN-SUFFIX,py.pl
DOMAIN-SUFFIX,pypl.com
DOMAIN-SUFFIX,braintreegateway.com
DOMAIN-SUFFIX,braintreepayments.com
DOMAIN-SUFFIX,braintree-api.com
DOMAIN-KEYWORD,paypal
USER-AGENT,PayPal*
